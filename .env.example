# PV+ environment configuration
# Copy to .env.local for development. Never commit real values.

# Supabase project (Development / Test / Validation / Production each need their own project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_ENV=development

# E2E smoke tests (e2e/, local only — see e2e/README.md)
E2E_DEMO_EMAIL=
E2E_DEMO_PASSWORD=
